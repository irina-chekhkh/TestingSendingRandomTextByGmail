<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Gmail Suite">
    <parameter name="browser" value="firefox"/>

    <listeners>
        <listener class-name="com.TestListener"/>
    </listeners>

    <test name="Gmail Tests">
        <classes>
            <class name="com.GmailTest"/>
        </classes>
    </test>

</suite>