<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Login Suite">
    <parameter name="browser" value="chrome"/>

    <listeners>
        <listener class-name="com.TestListener"/>
    </listeners>

    <test name="Right data login Tests">
        <classes>
            <class name="com.LoginTest">
                <methods>
                    <include name="loginWithRightData"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Wrong password login Tests">
        <classes>
            <class name="com.LoginTest">
                <methods>
                    <include name="loginWithWrongPassword"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Wrong email login Tests">
        <classes>
            <class name="com.LoginTest">
                <methods>
                    <include name="loginWithWrongEmail"/>
                </methods>
            </class>
        </classes>
    </test>


</suite>